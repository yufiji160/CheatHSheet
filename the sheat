package piscine

func IsCapitalized(s string) bool {
	if s == "" {
		return false
	}

	start := true

	for i := 0; i < len(s); i++ {
		c := s[i]

		if c == ' ' || c == '\t' || c == '\n' {
			start = true
			continue
		}

		if start {
			if c >= 'a' && c <= 'z' {
				return false
			}
			start = false
		}
	}

	return true
}
//itoa
package piscine

func Itoa(n int) string {
	if n == 0 {
		return "0"
	}

	result := ""
	negative := false

	if n < 0 {
		negative = true
	}

	for n != 0 {
		digit := n % 10

		if digit < 0 {
			digit = -digit
		}

		result = string(rune(digit+'0')) + result
		n /= 10
	}

	if negative {
		result = "-" + result
	}

	return result
}
