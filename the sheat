//hashcode
package main

func HashCode(dec string) string {
	n := len(dec)
	res := make([]byte, n)
	for i := 0; i < n; i++ {
		hashed := (int(dec[i]) + n) % 127
		if hashed < 32 {
			hashed += 33
		}
		res[i] = byte(hashed)
	}
	return string(res)
}
