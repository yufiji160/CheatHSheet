//weareunique
func WeAreUnique(str1, str2 string) int {
	if str1 == "" && str2 == "" {
		return -1
	}

	set1 := make(map[rune]bool)
	for _, r := range str1 {
		set1[r] = true
	}

	set2 := make(map[rune]bool)
	for _, r := range str2 {
		set2[r] = true
	}

	count := 0
	for r := range set1 {
		if !set2[r] {
			count++
		}
	}
	for r := range set2 {
		if !set1[r] {
			count++
		}
	}

	return count
}
//zipstring
import (
	"fmt"
)

func ZipString(s string) string {
	if s == "" {
		return ""
	}

	var result string
	count := 1
	for i := 0; i < len(s); i++ {
		if i+1 < len(s) && s[i] == s[i+1] {
			count++
		} else {
			result += fmt.Sprintf("%d%c", count, s[i])
			count = 1
		}
	}
	return result
}
