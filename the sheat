//repeatalpha
package main

func RepeatAlpha(s string) string {
	result := ""

	for _, r := range s {
		if r >= 'a' && r <= 'z' {
			for i := 0; i < int(r-'a'+1); i++ {
				result += string(r)
			}
		} else if r >= 'A' && r <= 'Z' {
			for i := 0; i < int(r-'A'+1); i++ {
				result += string(r)
			}
		} else {
			result += string(r)
		}
	}

	return result
}
//lastword
package main

func LastWord(s string) string {
	word := ""
	for i := len(s) - 1; i >= 0; i-- {
		if s[i] != ' ' {
			word = string(s[i]) + word
		} else if word != "" {
			break
		}
	}
	if word != "" {
		return word + "\n"
	}
	return "\n"
}
