//cameltosnake
package main

import (
	"fmt"
)

func CamelToSnakeCase(s string) string {
	if s == "" {
		return ""
	}

	runes := []rune(s)
	length := len(runes)

	for _, r := range runes {
		if !((r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z')) {
			return s
		}
	}

	if runes[length-1] >= 'A' && runes[length-1] <= 'Z' {
		return s
	}

	for i := 0; i < length-1; i++ {
		firstUpper := runes[i] >= 'A' && runes[i] <= 'Z'
		secondUpper := runes[i+1] >= 'A' && runes[i+1] <= 'Z'
		if firstUpper && secondUpper {
			return s
		}
	}

	var result []rune
	for i := 0; i < length; i++ {
		if i > 0 && runes[i] >= 'A' && runes[i] <= 'Z' {
			result = append(result, '_')
		}
		result = append(result, runes[i])
	}

	return string(result)
}
