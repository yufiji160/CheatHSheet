//printif
package main

func PrintIf(str string) string {
	if str == "" || len(str) >= 3 {
		return "G\n"
	}
	return "Invalid Input\n"
}
//printifnot
package main

func PrintIfNot(str string) string {
	if len(str) < 3 {
		return "G\n"
	}
	return "Invalid Input\n"
}
//checknumber
package main

func CheckNumber(arg string) bool {
	for _, r := range arg {
		if r >= '0' && r <= '9' {
			return true
		}
	}
	return false
}
//countalpha
package main

func CountAlpha(s string) int {
	count := 0
	for _, r := range s {
		if (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') {
			count++
		}
	}
	return count
}
//countchar
package main

func CountChar(str string, c rune) int {
	count := 0
	for _, r := range str {
		if r == c {
			count++
		}
	}
	return count
}
//rectperimeter
package main

func RectPerimeter(w, h int) int {
	if w < 0 || h < 0 {
		return -1
	}
	return 2 * (w + h)
}
//retainfirsthalf
package main

func RetainFirstHalf(str string) string {
	if len(str) <= 1 {
		return str
	}
	return str[:len(str)/2]
}
//repeatalpha
package main

func RepeatAlpha(s string) string {
	result := ""

	for _, r := range s {
		if r >= 'a' && r <= 'z' {
			for i := 0; i < int(r-'a'+1); i++ {
				result += string(r)
			}
		} else if r >= 'A' && r <= 'Z' {
			for i := 0; i < int(r-'A'+1); i++ {
				result += string(r)
			}
		} else {
			result += string(r)
		}
	}

	return result
}
//lastword
package main

func LastWord(s string) string {
	word := ""
	for i := len(s) - 1; i >= 0; i-- {
		if s[i] != ' ' {
			word = string(s[i]) + word
		} else if word != "" {
			break
		}
	}
	if word != "" {
		return word + "\n"
	}
	return "\n"
}
