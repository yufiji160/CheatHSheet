func FishAndChips(n int) string {
	if n < 0 {
		return "error: number is negative"
	}
	if n%2 == 0 && n%3 == 0 {
		return "fish and chips"
	} else if n%2 == 0 {
		return "fish"
	} else if n%3 == 0 {
		return "chips"
	}
	return "error: non divisible"
}
//gcd
package main

func Gcd(a, b uint) uint {
	if a == 0 || b == 0 {
		return 0
	}
	for b != 0 {
		a, b = b, a%b
	}
	return a
}
//hashcode
package main

func HashCode(dec string) string {
	n := len(dec)
	res := make([]byte, n)
	for i := 0; i < n; i++ {
		hashed := (int(dec[i]) + n) % 127
		if hashed < 32 {
			hashed += 33
		}
		res[i] = byte(hashed)
	}
	return string(res)
}
